DISCORD_TOKEN=your-bot-token-here
DATABASE_PATH=data/wisest-wizard.sqlite3
# Optional: remove audit records older than this many days. Unset retains them.
# AUDIT_RETENTION_DAYS=365

# Wisdom scoring, accumulation, and activity. The message cooldown is seconds.
WISDOM_MAX_CHARS=192
WISDOM_MESSAGE_COOLDOWN_SECONDS=1
WISDOM_SCORE_FLOOR=0
WISDOM_SCORE_CEIL=100
WISDOM_QUALITY_CURVE=1
WISDOM_GAIN=0.02
WISDOM_GRACE_DAYS=7
WISDOM_DECAY_PER_DAY=0.02
WISDOM_REFRESH_ON_ANY_MESSAGE=false
WISDOM_REPUTATION_COOLDOWN_SECONDS=86400
WISDOM_REPUTATION_CHANGE=1
WISDOM_REWARD_COOLDOWN_SECONDS=86400
WISDOM_REWARD_GAIN=0.02
